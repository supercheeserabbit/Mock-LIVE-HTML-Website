project:
  type: website
  output-dir: docs        
  # GitHub Pages: set "Deploy from branch > /docs" in repo settings

website:
  title: "The LIVE Project"
  # No navbar here — we use a custom HTML partial for exact visual match

format:
  html:
    theme: [flatly, custom.scss]
    include-in-header: _head.html
    include-before-body: _navbar.html
    page-layout: custom
    toc: false
    title-block-style: none
    include-after-body: _footer.html
